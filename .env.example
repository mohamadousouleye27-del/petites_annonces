# ============================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# ============================================
# Copiez ce fichier en « .env » puis adaptez les valeurs
# à votre machine (ou à votre serveur) :
#
#     copy .env.example .env
#
# ============================================

# --- Application ---
APP_NAME="PetitesAnnonces.sn"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/petites_annonces
APP_BASE_PATH=/petites_annonces
APP_TIMEZONE=Africa/Dakar

# --- Base de données ---
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=petites_annonces
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Session ---
SESSION_LIFETIME=7200
